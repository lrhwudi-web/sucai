# Import inside the existing pr.kairaygolf.com site block.
# Only content-hashed Vite outputs are immutable; unversioned public assets are excluded.
@frontend_build path_regexp frontend_build ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css)$
header @frontend_build Cache-Control "public, max-age=31536000, immutable"

@frontend_entry path / /index.html
header @frontend_entry Cache-Control "no-cache"
